  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Codecodeio\\StandWithUkraine\\": "src/"
    }
  },
  "extra": {
    "class": "Codecodeio\\StandWithUkraine\\Plugin"
  },
  "minimum-stability": "stable",
  "require": {
    "composer-plugin-api": ">=1.0"
  }
}
